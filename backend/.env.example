# Nexus Market Graph Configuration

# 1. Market Data Provider Options: 'hybrid', 'yfinance', 'finnhub', 'alphavantage', 'simulated'
DATA_PROVIDER=hybrid

# 2. Optional: Finnhub API Key (Free tier at https://finnhub.io)
FINNHUB_API_KEY=

# 3. Optional: Alpha Vantage API Key (Free tier at https://www.alphavantage.co)
ALPHAVANTAGE_API_KEY=

# 4. Optional: Gemini LLM API Key for advanced natural-language executive briefings (https://aistudio.google.com)
GEMINI_API_KEY=
